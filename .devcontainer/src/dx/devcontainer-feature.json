{
    "id": "dx",
    "version": "1.2.0",
    "name": "Gildraen DX runtime",
    "description": "Installs the shared Gildraen developer-experience runtime and common tool baseline under /opt/dx.",
    "documentationURL": "https://github.com/Gildraen/dx",
    "options": {
        "agentsVersion": {
            "type": "string",
            "default": "v0.1.0-rc.1",
            "description": "SemVer tag tracked for Gildraen/dx-agents."
        },
        "agentsCommit": {
            "type": "string",
            "default": "a448037a8b96b2269ac1b46f0ff2018738083c1e",
            "description": "Commit SHA resolved by agentsVersion."
        },
        "toolsVersion": {
            "type": "string",
            "default": "v0.1.0-rc.1",
            "description": "SemVer tag tracked for Gildraen/dx-tools."
        },
        "toolsCommit": {
            "type": "string",
            "default": "6630f37ffdc3a8c51af0f4795145a4743a61584b",
            "description": "Commit SHA resolved by toolsVersion."
        }
    },
    "customizations": {
        "vscode": {
            "settings": {
                "chat.defaultToCopilotHarness": false,
                "chat.editor.preferCopilotHarness": false,
                "chat.editor.localAgent.enabled": true,
                "chat.agentFilesLocations": {
                    ".agents/agents": true
                }
            }
        }
    },
    "containerEnv": {
        "DX_HOME": "/opt/dx",
        "DX_AGENTS_HOME": "/opt/dx/components/agents",
        "DX_TOOLS_HOME": "/opt/dx/components/tools",
        "GH_CONFIG_DIR": "/var/lib/dx/devcontainer/.gh"
    },
    "mounts": [
        {
            "source": "${localWorkspaceFolder}/.devcontainer",
            "target": "/var/lib/dx/devcontainer",
            "type": "bind"
        }
    ],
    "dependsOn": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/go-task:1": {
            "version": "3.53.1"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
            "packages": "git,jq,ripgrep,libatomic1"
        }
    }
}