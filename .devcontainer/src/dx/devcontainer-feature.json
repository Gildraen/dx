{
    "id": "dx",
    "version": "1.1.0",
    "name": "Gildraen DX runtime",
    "description": "Installs the shared Gildraen developer-experience runtime and common tool baseline (Go Task, jq, ripgrep) under /opt/dx.",
    "documentationURL": "https://github.com/Gildraen/dx",
    "options": {},
    "dependsOn": {
        "ghcr.io/devcontainers-extra/features/go-task:1": {
            "version": "3.53.1"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
            "packages": "git,jq,ripgrep"
        }
    },
    "installsAfter": [
        "ghcr.io/devcontainers/features/node",
        "ghcr.io/devcontainers/features/github-cli"
    ]
}