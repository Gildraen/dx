{
    "id": "dx",
    "version": "1.2.0",
    "name": "Gildraen DX runtime",
    "description": "Installs the shared Gildraen developer-experience runtime and common tool baseline under /opt/dx.",
    "documentationURL": "https://github.com/Gildraen/dx",
    "options": {},
    "containerEnv": {
        "DX_HOME": "/opt/dx"
    },
    "dependsOn": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers-extra/features/go-task:1": {
            "version": "3.53.1"
        },
        "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
            "packages": "git,jq,ripgrep,libatomic1"
        }
    }
}