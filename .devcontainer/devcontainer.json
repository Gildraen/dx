{
  "name": "dx",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",
  "initializeCommand": "git submodule update --init --recursive",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "./src/dx": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "chat.permissions.default": "autopilot",
        "chat.agentFilesLocations": {
          ".agents/agents": true,
          ".devcontainer/components/agents/agents": true
        },
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "mcp": {
        "servers": {
          "github": {
            "command": "dx-mcp",
            "args": [
              "github"
            ]
          }
        }
      },
      "extensions": [
        "bierner.markdown-mermaid"
      ]
    }
  },
  "remoteEnv": {
    "DX_AGENTS_HOME": "${containerWorkspaceFolder}/.devcontainer/components/agents",
    "DX_TOOLS_HOME": "${containerWorkspaceFolder}/.devcontainer/components/tools",
    "EDITOR": "code --wait",
    "VISUAL": "code --wait"
  }
}