#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-}"
shift || true

case "$TARGET" in
  github)
    SERVER="$ROOT_DIR/.tools/mcp-server-github/bin/github-mcp-server"
    if [[ ! -x "$SERVER" ]]; then
      echo "GitHub MCP server is not installed; run 'task install-tools' first." >&2
      exit 1
    fi
    exec "$SERVER" "$@"
    ;;
  "")
    echo "usage: .bin/mcp-run <server> [args...]" >&2
    exit 2
    ;;
  *)
    echo "unknown MCP server: $TARGET" >&2
    exit 2
    ;;
esac
