#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="${1:-}"
shift || true

case "$TARGET" in
  github)
    exec "$ROOT_DIR/.tools/mcp-server-github/bin/github-mcp-server" "$@"
    ;;
  "")
    echo "usage: .bin/mcp-run <server> [args...]" >&2
    exit 2
    ;;
  *)
    echo "unknown MCP server: $TARGET" >&2
    exit 2
    ;;
esac
