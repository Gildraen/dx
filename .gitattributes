# Default: normalize line endings to LF in the repo
* text=auto eol=lf

# Shell scripts: always LF (executable bit set via git update-index --chmod=+x)
src/dx/install.sh          text eol=lf
src/dx/runtime/bin/*       text eol=lf
src/dx/runtime/mcp/**/*.sh text eol=lf

# JSON / lock files: LF, no executable
*.json              text eol=lf
*.jsonc             text eol=lf
